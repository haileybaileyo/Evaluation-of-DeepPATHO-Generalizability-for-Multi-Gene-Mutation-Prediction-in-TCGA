data/raw/*
!data/raw/mutation_labels*.csv
!data/raw/egfr_*.csv
!data/raw/egfr_variants/
!data/raw/gdc_manifest*.csv
data/processed/
runs/
*.svs
*.pt
*.pth
*.ckpt

